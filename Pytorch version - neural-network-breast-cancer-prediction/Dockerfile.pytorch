# Utiliser l'image officielle PyTorch
FROM pytorch/pytorch:1.13.0-cuda11.6-cudnn8-runtime

# Définir l'utilisateur
USER root

# Installer les dépendances supplémentaires et mettre à jour pip
RUN apt-get update && apt-get install -y \
    python3-pip \
    && apt-get clean \
    && pip install --upgrade pip \
    && pip install --no-cache-dir \
    keras==2.10.0 \
    scikit-learn==1.0.2 \
    matplotlib==3.5.1 \
    numpy==1.21.2 \
    opencv-python==4.5.5.64 \
    tqdm==4.64.0 \
    jupyterlab

# Copier le code du projet dans le conteneur
WORKDIR /app
COPY . /app

# Exposer le port pour Jupyter Notebook
EXPOSE 8888

# Lancer Jupyter Notebook au démarrage du conteneur
CMD ["jupyter", "notebook", "--ip=0.0.0.0", "--port=8888", "--allow-root"]
